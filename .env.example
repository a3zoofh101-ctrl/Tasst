# PostgreSQL connection string
DATABASE_URL=

# Random 32+ byte secret used to sign session JWTs (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Random 32 byte (hex) key used to encrypt provider API keys at rest (e.g. `openssl rand -hex 32`)
ENCRYPTION_KEY=

# Shared secret required by /api/cron/orders to authorize the status-sync job
CRON_SECRET=

# Used only by the seed script to create the first admin account locally.
# Do not commit real values. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Public base URL of this deployment (no trailing slash), used to build
# payment gateway callback URLs, e.g. https://tasst.example.com
APP_URL=

# Moyasar (Mada/Visa/Mastercard/Apple Pay) — leave both empty to keep using
# the built-in Mock payment provider. Get sandbox keys at
# https://dashboard.moyasar.com (use the sk_test_... secret key first).
MOYASAR_SECRET_KEY=
# Shared token you choose yourself and register as part of the webhook URL
# in the Moyasar dashboard: .../api/payments/moyasar/webhook?token=<this>
MOYASAR_WEBHOOK_SECRET=

# Optional: auto-connect one real SMM provider (any panel using the classic
# action=services/add/status/balance API) the first time `prisma db seed`
# runs. Leave SEED_REAL_PROVIDER_API_URL/KEY empty to skip this entirely —
# nothing here is required. When set, the seed script imports the
# provider's *entire* catalog and activates it immediately at the given
# markup (0 = sell at exact provider cost, for personal use).
SEED_REAL_PROVIDER_NAME=
SEED_REAL_PROVIDER_API_URL=
SEED_REAL_PROVIDER_API_KEY=
SEED_REAL_PROVIDER_MARKUP_PERCENT=0

NODE_ENV=development
