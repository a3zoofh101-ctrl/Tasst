# PostgreSQL connection string
DATABASE_URL=

# Random 32+ byte secret used to sign session JWTs (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Random 32 byte (hex) key used to encrypt provider API keys at rest (e.g. `openssl rand -hex 32`)
ENCRYPTION_KEY=

# Shared secret required by /api/cron/orders to authorize the status-sync job
CRON_SECRET=

# Used only by the seed script to create the first admin account locally.
# Do not commit real values. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

NODE_ENV=development
